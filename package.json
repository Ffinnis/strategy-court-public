{
  "name": "strategy-court",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "db:migrate": "bun --cwd apps/api db:migrate",
    "build": "bun run --filter '*' build",
    "start": "bun --env-file=.env apps/api/dist/index.js",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "5.9.3"
  }
}
